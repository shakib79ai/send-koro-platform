{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run setup)",
      "Bash(npm run db:up)",
      "Bash(npm run db:migrate)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx drizzle-kit generate:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose up -d db)",
      "Bash(docker compose logs:*)",
      "Bash(stripe trigger:*)",
      "Bash(stripe events list:*)",
      "Bash(stripe logs tail:*)"
    ],
    "ask": [
      "Bash(npm run stripe:setup:*)",
      "Bash(npm run tiers:run:*)",
      "Bash(stripe listen:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Bash(cat **/.env:*)",
      "Bash(*--live*)",
      "Bash(*sk_live_*)"
    ]
  },
  "enableAllProjectMcpServers": false
}
