PORT=3001
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sendkoro_api
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sendkoro_api_test

# Auth
JWT_SECRET=change-me-at-least-32-characters-long-random
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# SMS for sign-in codes: console (prints the code in the server log) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Payments service (services/payments)
PAYMENTS_URL=http://localhost:3000
PAYMENTS_INTERNAL_KEY=change-me-dev-only

# Delivery providers: mock | sandbox | live
UBER_DIRECT_MODE=mock
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
DOORDASH_DRIVE_MODE=mock
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
# Order to try providers in (own_driver first when a driver is nearby)
DISPATCH_ORDER=own_driver,uber_direct,doordash_drive

# Push notifications: console | fcm
PUSH_PROVIDER=console
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Public app URLs (CORS + links)
CUSTOMER_WEB_URL=http://localhost:3100
RESTAURANT_WEB_URL=http://localhost:3200
ADMIN_WEB_URL=http://localhost:3300
