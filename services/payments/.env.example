# ── Stripe (use a SANDBOX key while building: sk_test_... ) ─────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Expected platform account (from the technical brief). The setup script warns if the key belongs to another account.
STRIPE_PLATFORM_ACCOUNT_ID=acct_1UVa9IQzpvBKCndf
# Webhook signing secrets — printed by `npm run stripe:setup` (or by `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_platform_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_replace_me
STRIPE_THIN_EVENTS_SECRET=whsec_thin_replace_me

# ── App ─────────────────────────────────────────────────────────────────────
PORT=3000
PUBLIC_BASE_URL=https://api.sendkoro.com
RESTAURANT_PORTAL_URL=https://restaurants.sendkoro.com
DRIVER_APP_URL=https://drivers.sendkoro.com
PAYMENT_METHOD_DOMAIN=sendkoro.com
# Docker Postgres from the repo root (npm run db:up) listens on 5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sendkoro
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sendkoro_test
# Shared key for the internal API (replace with real service auth before production)
INTERNAL_API_KEY=change-me-dev-only

# ── Business rules (confirm before launch — see README "Decisions") ────────
# Estimated Stripe fee used only to check a restaurant can cover its share (2.9% + 30¢ default)
EST_STRIPE_FEE_BPS=290
EST_STRIPE_FEE_FIXED_CENTS=30

# Delivery markup (5 Nov 2026): delivery price = courier price + payout cost + the delivery money's card-fee share.
DELIVERY_MARKUP=true
OWN_DRIVER_PAYOUT_FEE_BPS=25
OWN_DRIVER_PAYOUT_FEE_CENTS=25
THIRD_PARTY_PAYMENT_FEE_BPS=25
THIRD_PARTY_PAYMENT_FEE_CENTS=25
FIRST_MONTH_FREE=true
